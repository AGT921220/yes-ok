APP_NAME=yes-ok

# Usuario administrador (php artisan admin:create)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# Si ejecutas Artisan/PHP en tu máquina con MySQL en Docker (puerto publicado): 127.0.0.1
# En docker-compose.yml los servicios php/horizon/scheduler fuerzan DB_HOST=mysql en el contenedor.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yes-ok
DB_USERNAME=yes-ok
DB_PASSWORD=yes-ok123

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

REDIS_CLIENT=phpredis
# Misma idea: 127.0.0.1 si corres Artisan fuera de Docker; dentro del contenedor Compose usa REDIS_HOST=redis
REDIS_HOST=127.0.0.1
# Dejar vacío si Redis no tiene contraseña (no escribas la palabra "null")
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# JWT Configuration (si usas tymon/jwt-auth)
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Agendamiento: ventana horaria permitida (sin "forzar cita") y paso entre slots (minutos)
BOOKING_SCHEDULE_START=12:00
BOOKING_SCHEDULE_END=20:00
BOOKING_SLOT_STEP_MINUTES=15

# CORS (orígenes permitidos, separados por coma; sin barra final)
# Producción: solo el dominio del frontend
# CORS_ORIGINS=https://yes-ok.agsoftweb.com.mx
# Local: varios orígenes
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://yes-ok.agsoftweb.com.mx

# Horizon
HORIZON_BALANCE=auto
HORIZON_MAX_PROCESSES=10

# Log Viewer API: token para /log-viewer/api/* (header X-Log-Viewer-Token). Generar valor largo y seguro.
LOG_VIEWER_TOKEN=

# Firebase / FCM. No commits de claves: van solo en .env.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FCM_TEST_TOKEN=
