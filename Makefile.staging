utils/paste-master:
	@CURRENT_BRANCH=$$(git rev-parse --abbrev-ref HEAD); \
    git checkout master; \
    git pull origin master; \
    git checkout $$CURRENT_BRANCH; \
    git merge master;

install-xdebug:
	@apk add --no-cache $PHPIZE_DEPS \
    && pecl install xdebug-2.9.2 \
    && docker-php-ext-enable xdebug 
phpunit-config:
	@alias phpunit='./vendor/bin/phpunit';
ngrok:
	@ngrok http --host-header=rewrite http://localhost;

create-valid-path:
	@mkdir -p storage/framework/cache \
	mkdir -p storage/framework/views

import-db:
	@docker exec -i ${DB_HOST} mysql -u${DB_USERNAME} -p${DB_PASSWORD} \
		-e "DROP DATABASE IF EXISTS \`${DB_DATABASE}\`; CREATE DATABASE \`${DB_DATABASE}\`;"
	@docker exec -i ${DB_HOST} mysql -u${DB_USERNAME} -p${DB_PASSWORD} \
		${DB_DATABASE} < storage/app/yes-ok-staging.sql

testing/import-db:
	@docker exec -i ${DB_HOST} mysql -u user -ppassword -e "DROP DATABASE IF EXISTS testing; CREATE DATABASE testing;"
	@docker exec -i ${DB_HOST} mysql -u user -ppassword testing < storage/app/yes-ok-staging.sql

restart-testing:
	@docker exec -i yes-ok-staging_mysql bash -c "\
		mysql -u root -p1234 -e 'DROP DATABASE IF EXISTS testing; CREATE DATABASE testing; GRANT ALL PRIVILEGES ON testing.* TO \"user\"@\"%\" IDENTIFIED BY \"password\" WITH GRANT OPTION; FLUSH PRIVILEGES;'"\

refresh-database-performance:
	# Ejecutar comandos en el contenedor MySQL
	@docker exec -i yes-ok-staging_mysql bash -c "\
		mysql -u root -p1234 -e 'DROP DATABASE IF EXISTS performance; CREATE DATABASE performance; GRANT ALL PRIVILEGES ON performance.* TO \"user\"@\"%\" IDENTIFIED BY \"password\" WITH GRANT OPTION; FLUSH PRIVILEGES;'"
	
	# Ejecutar comandos en el contenedor PHP
	@docker exec -it php-yes-ok-staging bash -c "php artisan migrate --env=performance"
	@docker exec -it php-yes-ok-staging bash -c "php artisan initial_setup_performance"

restart-database-performance:
	@docker exec -i yes-ok-staging_mysql mysql -u user -ppassword -e "DROP DATABASE IF EXISTS performance; CREATE DATABASE performance;"
	@docker exec -i yes-ok-staging_mysql mysql -u user -ppassword performance < ./storage/app/performance.sql


