staging/import-db:
	@docker exec -i mysql-staging mysql -u user -p${DB_PASSWORD} -e "DROP DATABASE IF EXISTS \`yes-ok-staging\`; CREATE DATABASE \`yes-ok-staging\`;"
	@docker exec -i mysql-staging mysql -u user -p${DB_PASSWORD} yes-ok-staging < storage/app/yes-ok-staging.sql

check-opcache:
	@echo "🧪 Creando archivo temporal para prueba FPM..."
	@(docker compose exec -T php sh -lc 'printf "<?php echo \"mtime=\".filemtime(\"../routes/web.php\");" > /var/www/html/public/_checkop.php' \
	 || docker exec -i php-yes-ok-staging sh -lc 'printf "<?php echo \"mtime=\".filemtime(\"../routes/web.php\");" > /var/www/html/public/_checkop.php')

	@echo "🌐 Probando vía host → Nginx → FPM (http://localhost/_checkop.php)..."
	@curl -fsS http://localhost/_checkop.php || echo "⚠️ No se pudo acceder vía host→Nginx→FPM"

	@echo "\n🧰 Validando OPcache en CLI..."
	@(docker compose exec -T php sh -lc "php -i | grep -E 'opcache.validate_timestamps|opcache.revalidate_freq|revalidate_path|file_update_protection|realpath_cache_ttl'" \
	 || docker exec -i php-yes-ok-staging sh -lc "php -i | grep -E 'opcache.validate_timestamps|opcache.revalidate_freq|revalidate_path|file_update_protection|realpath_cache_ttl'")

	@echo "🧹 Limpiando archivo temporal..."
	@(docker compose exec -T php sh -lc 'rm -f /var/www/html/public/_checkop.php' \
	 || docker exec -i php-yes-ok-staging sh -lc 'rm -f /var/www/html/public/_checkop.php')

	@echo "\n✅ Listo. Si viste 'mtime=' y las directivas correctas, FPM y CLI están OK."
pull-database-server:
